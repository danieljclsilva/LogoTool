{
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "name": "logotool-foundations",
  "private": true,
  "scripts": {
    "build": "tsc && node scripts/build-inspector.mjs",
    "test": "npm run build && node --test dist/tests-ts/*.test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.viewer.json && tsc -p tsconfig.e2e.json",
    "generate:models": "node scripts/generate-synthetic-glb.mjs",
    "test:e2e": "npm run build && playwright test --project=chromium",
    "test:e2e:chrome": "npm run build && playwright test --project=chrome",
    "test:e2e:edge": "npm run build && playwright test --project=msedge",
    "test:e2e:matrix": "npm run build && playwright test"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "three": "^0.186.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
