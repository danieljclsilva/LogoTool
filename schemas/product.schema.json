{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flexitog.example/logotool/product.schema.json",
  "title": "LogoTool provisional product definition",
  "description": "PROVISIONAL draft (schemaVersion 0.1.0-provisional). Defines a generalized product with variants, 2D regions and calibrations. Draft status: subject to the Phase 1 Odoo-discovery exit gate; do not treat as final. Synthetic fixture data only; no real customer, artwork or calibration values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "variants", "regions", "calibrations"],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0-provisional",
      "description": "Provisional schema version literal. Any other or missing value must be rejected with a version error."
    },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": {
      "type": "string",
      "enum": ["upper-body", "lower-body", "full-body", "headwear", "other"],
      "description": "Generalized product kind. No clothing-specific logic may live in core."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/variant" }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/region" }
    },
    "calibrations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calibration" },
      "description": "Calibration definitions. Ids must be unique within the product; every region.calibrationRef must resolve to one of these. A customer return introducing an unknown calibration id/version must be rejected as tamper."
    }
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "regionIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "regionIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Subset of the product region ids this variant supports (per-variant applicability)."
        },
        "placementOverrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/placementOverride" },
          "description": "Optional per-variant placement overrides (e.g. size-scaled default widths)."
        }
      }
    },
    "placementOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regionId"],
      "properties": {
        "regionId": { "type": "string", "minLength": 1 },
        "widthMm": { "type": "number", "exclusiveMinimum": 0 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame", "calibrationRef", "safeArea", "allowedMethods"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "frame": { "$ref": "#/$defs/frame" },
        "calibrationRef": { "$ref": "#/$defs/calibrationRef" },
        "safeArea": {
          "$ref": "#/$defs/polygon",
          "description": "Safe-area polygon in the region frame (mm). Minimum 3 finite points."
        },
        "exclusions": {
          "type": "array",
          "items": { "$ref": "#/$defs/polygon" },
          "description": "Exclusion polygons in the region frame (mm). Optional; defaults to none."
        },
        "allowedMethods": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameId", "originDescription", "axes"],
      "properties": {
        "frameId": { "type": "string", "minLength": 1 },
        "originDescription": { "type": "string", "minLength": 1 },
        "axes": { "$ref": "#/$defs/axes" }
      },
      "description": "2D region frame: origin at the region datum; +x right, +y up facing the region; millimetres."
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xPositive", "yPositive"],
      "properties": {
        "xPositive": { "type": "string", "minLength": 1 },
        "yPositive": { "type": "string", "minLength": 1 }
      }
    },
    "calibrationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibrationId", "version"],
      "properties": {
        "calibrationId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "description": "Must resolve to an entry of the enclosing product calibrations[]."
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" },
      "description": "Closed polygon as [x, y] pairs in mm. JSON cannot represent NaN/Infinity; core additionally enforces Number.isFinite on every coordinate."
    },
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    }
  }
}
