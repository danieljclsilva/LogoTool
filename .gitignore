# LogoTool — FlexiTog 3D Configurator (TypeScript/React/Three.js/Vite, offline)
# Scoped .gitignore: ignore only local noise, generated output, secrets, and
# explicitly named private/customer dirs. Source, docs, schemas, examples,
# tests, and Odoo evidence stay tracked.

# 1. OS noise (macOS / Windows / Linux)
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
*~

# 2. Dependencies
node_modules/

# 3. Generated builds / caches / test outputs (Vite + TypeScript)
dist/
build/
*.tsbuildinfo
coverage/
test-results/
playwright-report/
__pycache__/
*.py[cod]
.pytest_cache/

# 4. Local credentials / env (samples stay tracked)
.env
.env.*
*.pem
*.key
!.env.example
!*.env.example
!.env.template
!*.env.template

# 5. OMP / Codex local sessions (local-only agent state)
.omp/
.codex/

# 6. Private / customer input-output dirs (explicit list, not yet in repo)
private/
customer-input/
customer-output/
customer-data/
